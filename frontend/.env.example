# --- Frontend env ---
# For LOCAL dev, you can leave VITE_API_BASE unset — the Vite dev server
# proxies /api -> http://127.0.0.1:8000 (see vite.config.js).
#
# For PRODUCTION (Vercel), you MUST set VITE_API_BASE in the Vercel dashboard
# (Project Settings -> Environment Variables) to the public URL of your
# deployed Laravel API, e.g.:
#   VITE_API_BASE=https://api.your-domain.com/api
# Vercel does NOT run PHP, so the backend must be hosted elsewhere
# (Railway, Render, Fly.io, a VPS, Laravel Forge, etc.).
VITE_API_BASE=

# Laravel Reverb / Pusher WebSocket (must match backend .env REVERB_* values).
# Leave empty in production if you don't deploy Reverb.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
